{% macro section(title, content) %}
  {% if content %}
    <section class="section">
      <h2 class="section__title">{{ title }}</h2>

      {% if content | isArray %}
        <ul class="section__list">
          {% for item in content %}
            <li class="section__item">{{ item }}</li>
          {% endfor %}
        </ul>
      {% else %}
        <p class="section__text">{{ content }}</p>
      {% endif %}
    </section>
  {% endif %}
{% endmacro %}

