flowchart TB
  DOG["Dog\nhero object"]

  subgraph PROFILE["Care profile — section groupings"]
    direction TB

    subgraph IDENTITY["Identity"]
      ID_FIELDS["name · breed · gender · size · DOB\nenergy · vaccinated · neutered · house-trained · insurance"]
    end

    subgraph ROUTINE["Routine"]
      R_FIELDS["treats · exercise"]
      FEEDING["feeding[]"]
      BATHROOM["bathroom[]"]
    end

    subgraph BEHAVIOUR["Behaviour"]
      B_FIELDS["enjoys · struggles · commands · notes"]
    end

    subgraph HEALTH["Health"]
      H_FIELDS["conditions · trauma · veterinarian"]
      MEDICATION["medication[]"]
    end

    subgraph SECURITY["Security"]
      S_FIELDS["microchipped · microchip · has_tracker · tracker_id · tracker_consent"]
    end
  end

  FAMILY["Family\nname · email · phone · address · billing_mode"]
  BOOKING["Booking\ndogs · dates · status · payment"]
  STATEMENT["Statement\nstart · end · total · sent"]
  EMERGENCY["Emergency contact\nname · phone"]
  OWNER["Owner account\nactive · revoked"]
  PORTAL_INV["Portal invite"]
  INTAKE["Intake link"]

  DOG --- PROFILE
  DOG -.->|has| EMERGENCY
  FAMILY -->|has many| DOG
  FAMILY -.->|emergency shortcut| EMERGENCY
  FAMILY -->|one| OWNER
  FAMILY -->|generates| PORTAL_INV
  FAMILY -->|generates| INTAKE
  DOG -->|included in| BOOKING
  FAMILY -->|billed to| BOOKING
  FAMILY -->|statements| STATEMENT
  BOOKING -->|included in| STATEMENT

  classDef hero fill:#fef3c7,stroke:#d97706,stroke-width:2px
  classDef grouping fill:#e0f2fe,stroke:#0284c7
  classDef fields fill:#f0fdf4,stroke:#16a34a
  classDef context fill:#f3f4f6,stroke:#6b7280

  class DOG hero
  class IDENTITY,ROUTINE,BEHAVIOUR,HEALTH,SECURITY grouping
  class ID_FIELDS,R_FIELDS,B_FIELDS,H_FIELDS,S_FIELDS,FEEDING,BATHROOM,MEDICATION fields
  class FAMILY,BOOKING,STATEMENT,EMERGENCY,OWNER,PORTAL_INV,INTAKE context
